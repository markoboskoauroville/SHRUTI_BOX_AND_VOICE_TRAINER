<?xml version="1.0" encoding="utf-8"?>
<!-- One permission: the microphone, for the voice trainer (v6), asked for the first time the trainer is switched on.
     The reeds are synthesised on the phone; the voice is heard frame by frame and never kept; nothing is fetched. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v26: it plays on with the app out of focus, held by a media-playback foreground service and its notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v11: a MIDI controller plays the box when the phone has MIDI; without it the app is the same -->
    <uses-feature android:name="android.software.midi" android:required="false" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Shruti">
        <!-- Portrait, as his phone always is (the Camera language's landscape is for cameras only): the lock is on
             purpose, so lint is told so rather than switched off. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".ShrutiService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
